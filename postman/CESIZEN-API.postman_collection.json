              "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"title\": \"Article test {{$timestamp}}\",\n  \"description\": \"Description article de test\",\n  \"content\": \"Contenu complet de l article de test.\",\n  \"imagePath\": \"/uploads/article-test.jpg\"\n}"
