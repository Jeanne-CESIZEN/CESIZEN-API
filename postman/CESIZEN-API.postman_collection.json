{
  "info": {
    "_postman_id": "9a7b4ab6-91f2-4f5d-8f38-d8b7f4b2541c",
    "name": "CESIZEN API - Complete Routes",
    "description": "Collection complete pour tester toutes les routes users, categories et articles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "if (json?.data?.id) { pm.collectionVariables.set('userId', String(json.data.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"email\": \"john.doe+{{$timestamp}}@mail.com\",\n  \"password\": \"Password123\",\n  \"role\": \"USER\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get Active Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/active"
          }
        },
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/search?q=john&role=USER&isActive=true"
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John Updated\",\n  \"lastname\": \"Doe Updated\",\n  \"email\": \"john.updated+{{$timestamp}}@mail.com\",\n  \"password\": \"Password1234\",\n  \"role\": \"USER\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{userId}}/deactivate"
          }
        },
        {
          "name": "Activate User",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{userId}}/activate"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
